@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_LayoutMain.cshtml";
}

@section heads
{
    <title>مدیریت  تک صفحه نمایش</title>
    <style>
        .html-editor-wrapper {
            border: 1px solid #ddd;
            border-radius: 8px;
            margin: 10px 0;
            overflow: hidden;
            background: #fff;
        }

        .html-editor-tabs {
            display: flex;
            background: #f5f5f5;
            border-bottom: 1px solid #ddd;
        }

        .html-tab {
            flex: 1;
            padding: 10px 15px;
            border: none;
            background: transparent;
            cursor: pointer;
            font-family: inherit;
            font-size: 14px;
            color: #666;
            transition: all 0.2s;
            border-bottom: 2px solid transparent;
        }

            .html-tab:hover {
                background: #ebebeb;
            }

            .html-tab.active {
                color: #2563eb;
                border-bottom-color: #2563eb;
                background: #fff;
                font-weight: 600;
            }

        .html-panel {
            display: none;
            padding: 10px;
        }

            .html-panel.active {
                display: block;
            }

            .html-panel textarea {
                width: 100%;
                min-height: 220px;
                font-family: 'Consolas', 'Monaco', monospace;
                direction: ltr;
                text-align: left;
                border: 1px solid #e0e0e0;
                border-radius: 6px;
                padding: 10px;
                resize: vertical;
                font-size: 13px;
            }

        #SitePageHtmlPreview {
            width: 100%;
            min-height: 220px;
            border: 1px solid #e0e0e0;
            border-radius: 6px;
            background: #fff;
        }

        .html-tab[data-tab="fullscreen"] {
            color: #2563eb;
        }

            .html-tab[data-tab="fullscreen"]:hover {
                background: #e0ecff;
            }
    </style>
}
@section scripts {
    <script src="~/js/SitePages/SitePages.js"></script>
}
@section html
{
    lang="fa" dir="rtl"
}

<div class="main-content" id="mainContent">
    <div class="container">
        <div class="page-header">
            <h2><i class="fas fa-users"></i> مدیریت  تک صفحه های نمایشی</h2>
            <button class="btn-add" onclick="openAddModal()"><i class="fas fa-plus"></i> افزودن  تک صفحه نمایش جدید</button>
        </div>

        <div class="stats-cards" id="statsCards"></div>

        <div class="search-filter-bar">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" id="searchSitePage" placeholder="جستجو بر اساس ایتم ها...">
            </div>
            <select id="statusFilter" class="filter-select">
                <option value="all">همه وضعیت‌ها</option>
                <option value="true">فعال</option>
                <option value="false">غیرفعال</option>
            </select>
        </div>

        <div class="table-wrapper">
            <table id="personelTable">
                <thead>
                    <tr>
                        <th>شناسه</th>
                        <th>عنوان سایت</th>
                        <th>کد دسترسی داخلی</th>
                        <th>وضعیت</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody id="SitePageTableBody"></tbody>
            </table>
        </div>
    </div>
</div>

<div id="SitePageModal" class="modal-overlay">
    <div class="modal modelInput">
        <h3 id="modalTitle">افزودن  تک صفحه نمایشی جدید</h3>

        <input type="number" id="SitePageId" placeholder="شناسه">
        <input type="text" id="SitePageCaption" placeholder="عنوان سایت">
        <div class="html-editor-wrapper">
            <div class="html-editor-tabs">
                <button type="button" class="html-tab active" data-tab="code" onclick="switchHtmlTab('code')">
                    <i class="fas fa-code"></i> کد HTML
                </button>
                <button type="button" class="html-tab" data-tab="preview" onclick="switchHtmlTab('preview')">
                    <i class="fas fa-eye"></i> پیش‌نمایش
                </button>
                <button type="button" class="html-tab" data-tab="fullscreen" onclick="openFullScreenPreview()">
                    <i class="fas fa-expand"></i> نمایش تمام صفحه
                </button>
            </div>

            <div id="htmlCodePanel" class="html-panel active">
                <textarea id="SitePageHtml" class="extra" placeholder="کدهای html"></textarea>
            </div>

            <div id="htmlPreviewPanel" class="html-panel">
                <iframe id="SitePageHtmlPreview" sandbox="allow-same-origin"></iframe>
            </div>
        </div>
        <input type="text" id="CodePage" placeholder="کد دسترسی داخلی">
        <div style="display:flex;">
            <label>وضعیت</label> 
            <input type="checkbox" id="Status" placeholder="وضعیت" style="width: 10%;margin-top: 5px;">
        </div>
        <div class="modal-buttons">
            <button class="btn-save" onclick="SaveNewModel()">ذخیره</button>
            <button class="btn-cancel" onclick="CanselSaveModal()">انصراف</button>
        </div>
    </div>
</div>




