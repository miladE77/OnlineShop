<!DOCTYPE html>
<html @RenderSection("html", required: false)>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/account.css" />
    <link rel="stylesheet" href="~/lib/persian-datepicker/css/persian-datepicker.min.css">
    @RenderSection("heads", required: false)
</head>
<body>
    <div>
        @RenderBody()
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- Persian DatePicker -->
    <script src="~/lib/persian-datepicker/js/persian-date.min.js"></script>
    <script src="~/lib/persian-datepicker/js/persian-datepicker.min.js"></script>
    <script src="~/js/PersianDateInit.js"></script>


    @await RenderSectionAsync("scripts", required: false)
</body>
</html>
