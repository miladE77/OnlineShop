@{
    ViewData["Title"] = "sot";

    Layout = "~/Views/Shared/_LayoutStore.cshtml";
}
@section heads

{
    <title>مدیریت سفارشات</title>
    <link rel="stylesheet" href="/Store/css/ProductStyle.css">
}
@section scripts

{
    <script src="/js/Store/StoresProdact.js"></script>
}
@section html

{
    lang="fa" dir="rtl"
}

<div class="main-content" id="mainContent">
    <div class="product-detail-container">
        <div class="page-header">
            <h2><i class="fas fa-box"></i> جزئیات محصول</h2>
            <span id="productIdDisplay" style="font-size:0.85rem;color:var(--text-secondary);">#---</span>
        </div>

        <!-- اطلاعات اصلی محصول -->
        <div class="product-main" id="productMain">
            <!-- گالری -->
            <div class="gallery-section">
                <div class="gallery-main" id="galleryMain">
                    <div class="no-image">
                        <i class="fas fa-image"></i>
                        <span>در حال بارگذاری...</span>
                    </div>
                </div>
                <div class="gallery-thumbs" id="galleryThumbs"></div>
            </div>

            <!-- اطلاعات -->
            <div class="info-section" id="infoSection">
                <div class="product-title" id="productTitle">---</div>
                <div class="product-code">کد: <span id="productCode">---</span></div>
                <div class="product-price" id="productPrice">--- <small>تومان</small></div>
                <div class="product-description" id="productDescription">---</div>

                <div class="color-section">
                    <span class="color-label"><i class="fas fa-palette"></i> انتخاب رنگ و قیمت:</span>
                    <div class="color-options" id="colorOptionsItems"></div>
                </div>

                <button class="add-to-cart-btn" id="addToCartBtn" disabled>
                    <i class="fas fa-shopping-cart"></i> افزودن به سبد خرید
                </button>
            </div>
        </div>

        <!-- جزئیات بیشتر -->
        <div class="product-details-grid">
            <!-- مشخصات فنی -->
            <div class="detail-card">
                <div class="card-title"><i class="fas fa-cogs"></i> مشخصات فنی</div>
                <div id="specsContainer">
                    <div class="no-data"><i class="fas fa-info-circle"></i> مشخصاتی ثبت نشده است</div>
                </div>
            </div>

            <!-- توضیحات تکمیلی -->
            <div class="detail-card">
                <div class="card-title"><i class="fas fa-list-ul"></i> توضیحات تکمیلی</div>
                <div id="detailsContainer">
                    <div class="no-data"><i class="fas fa-info-circle"></i> توضیحاتی ثبت نشده است</div>
                </div>
            </div>
        </div>
    </div>
</div>
<!-- Toast -->
<div class="toast" id="toast"></div>

