@{
    ViewData["Title"] = "sot";

    Layout = "~/Views/Shared/_LayoutStore.cshtml";
}
@section heads

{
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/css/fontawesome/css/all.min.css">
    <title>مدیریت سفارشات</title>
    <link rel="stylesheet" href="/Store/css/StyleProfile.css">
}
@section scripts

{
    <script src="/js/Store/StoresProfile.js"></script>
}
@section html

{
    lang="fa" dir="rtl"
}


<div class="main-content" id="mainContent">
    <div class="profile-container">

        <!-- هدر پروفایل -->
        <div class="profile-hero">
            <div class="profile-hero-left">
                <div class="profile-hero-avatar" id="avatarDisplay">ع</div>
                <div class="profile-hero-info">
                    <h2 id="heroName">در حال بارگذاری...</h2>
                    <p id="heroRole">---</p>
                </div>
            </div>
            <div class="profile-hero-stats">
                <div class="stat-item">
                    <div class="number" id="statStores">0</div>
                    <div class="label">فروشگاه</div>
                </div>
                <div class="stat-item">
                    <div class="number" id="statOrders">0</div>
                    <div class="label">سفارشات</div>
                </div>
                <div class="stat-item">
                    <div class="number" id="statProducts">0</div>
                    <div class="label">محصولات</div>
                </div>
            </div>
        </div>

        <!-- گرید -->
        <div class="profile-grid">
            <!-- اطلاعات شخصی -->
            <div class="card">
                <div class="card-title">
                    <i class="fas fa-user"></i> اطلاعات شخصی
                    <span class="badge" id="statusBadge">در حال بارگذاری</span>
                </div>

                <div id="viewMode">
                    <div class="info-row"><span class="label">نام</span><span class="value" id="viewFirstName">---</span></div>
                    <div class="info-row"><span class="label">نام خانوادگی</span><span class="value" id="viewLastName">---</span></div>
                    <div class="info-row"><span class="label">تاریخ تولد</span><span class="value" id="viewBirth">---</span></div>
                    <div class="info-row"><span class="label">کد ملی</span><span class="value" id="viewNational">---</span></div>
                    <div class="info-row"><span class="label">آدرس</span><span class="value" id="viewAddress">---</span></div>
                    <div class="info-row"><span class="label">توضیحات</span><span class="value" id="viewDetail">---</span></div>
                    <button class="btn-edit-profile" id="enableEditBtn"><i class="fas fa-edit"></i> ویرایش اطلاعات</button>
                </div>

                <div class="edit-form" id="editForm">
                    <input type="text" id="editFirstName" placeholder="نام">
                    <input type="text" id="editLastName" placeholder="نام خانوادگی">
                    <input type="text" id="editBirth" placeholder="تاریخ تولد (مثال: ۱۳۷۰/۰۵/۲۰)">
                    <input type="text" id="editNational" placeholder="کد ملی">
                    <textarea id="editDetail" rows="2" placeholder="توضیحات بیشتر"></textarea>
                    <div class="form-buttons">
                        <button class="btn-save" id="saveProfileBtn">ذخیره</button>
                        <button class="btn-cancel" id="cancelEditBtn">انصراف</button>
                    </div>
                </div>
            </div>

            <!-- فروشگاه‌ها -->
            <div class="card">
                <div class="card-title">
                    <i class="fas fa-store-alt"></i> فروشگاه‌های من
                    <span class="badge" id="storeCount">0</span>
                </div>
                <div id="storesList">
                    <div class="no-items"><i class="fas fa-spinner fa-spin"></i> در حال بارگذاری...</div>
                </div>
                <button class="btn-add-store" id="openAddStoreModal"><i class="fas fa-plus-circle"></i> افزودن فروشگاه جدید</button>
            </div>

            <!-- سفارشات اخیر -->
            <div class="card" style="grid-column: 1 / -1;">
                <div class="card-title">
                    <i class="fas fa-clock-rotate-left"></i> سفارشات اخیر
                    <span class="badge" id="orderCount">0</span>
                </div>
                <div id="ordersList">
                    <div class="no-items"><i class="fas fa-spinner fa-spin"></i> در حال بارگذاری...</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- مودال افزودن فروشگاه -->
<div class="modal-overlay" id="storeModal">
    <div class="modal">
        <h3><i class="fas fa-store"></i> افزودن فروشگاه جدید</h3>
        <input type="text" id="storeCaptionInput" placeholder="عنوان فروشگاه *" />
        <input type="text" id="storeAddressInput" placeholder="آدرس فروشگاه *" />
        <div class="modal-buttons">
            <button class="btn-save-modal" id="saveStoreBtn">ذخیره</button>
            <button class="btn-cancel-modal" id="closeStoreModal">انصراف</button>
        </div>
    </div>
</div>
