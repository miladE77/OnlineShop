@{
    ViewData["Title"] = "ویترین محصولات";
    Layout = "~/Views/Shared/_LayoutStore.cshtml";
}

@section heads
{
    <title>ویترین محصولات | @ViewData["ShopName"]</title>
    <link rel="stylesheet" href="/Store/css/StyleVitrin.css">
}

@section scripts {
    <script src="/js/Store/StoresVitrin.js"></script>
}

@section html
{
    lang="fa" dir="rtl"
}

<main class="main-wrap" id="mainContent">
    <div class="page-head">
        <h1>
            <i class="fas fa-store-alt"></i>
            ویترین محصولات
        </h1>
        <div class="page-head-actions">
            <span class="count" id="resultCount">۰ محصول</span>
        </div>
    </div>

    <div class="products-grid" id="productsGrid" aria-live="polite"></div>
</main>