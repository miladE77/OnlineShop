@{
    ViewData["Title"] = "VitrinShop";
    Layout = "~/Views/Shared/_LayoutStore.cshtml";
}

@section heads
{
    <title>محصولات</title>
    <link rel="stylesheet" href="/Store/css/StyleVitrin.css">
}
@section scripts {
    <script src="/js/Store/StoresVitrin.js"></script>
}
@section html
{
    lang="fa" dir="rtl"
}

<main class="main-content" id="mainContent">
    <div class="vitrin-head">
        <h2><i class="fas fa-store-alt"></i> ویترین محصولات</h2>
        <span class="vitrin-count" id="resultCount"></span>
    </div>
    <div id="productsGrid" class="products-grid"></div>
</main>