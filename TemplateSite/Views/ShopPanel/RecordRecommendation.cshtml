@{
    ViewData["Title"] = "ثبت سفارش";
    Layout = "~/Views/Shared/_LayoutStore.cshtml";
}

@section heads
{
    <title>ثبت سفارش و پرداخت</title>
    <link rel="stylesheet" href="/Store/css/StyleRecommendation.css">
}

@section scripts
{
    <script src="/js/Store/StoresRecommendation.js"></script>
}

@section html
{
    lang="fa" dir="rtl"
}

<div class="main-content" id="mainContent">
    <div class="order-container">
        <div class="page-header">
            <h2><i class="fas fa-clipboard-list"></i> ثبت سفارش و پرداخت</h2>
            <span style="font-size:0.85rem;color:var(--text-secondary);">
                # سفارش: <span id="orderNumber">جدید</span>
            </span>
        </div>

        <!-- مراحل -->
        <div class="steps">
            <div class="step active" id="step1">
                <span class="num">1</span>
                <span>محصولات سبد</span>
            </div>
            <span class="step-separator"><i class="fas fa-chevron-left"></i></span>
            <div class="step" id="step2">
                <span class="num">2</span>
                <span>نوع پرداخت</span>
            </div>
            <span class="step-separator"><i class="fas fa-chevron-left"></i></span>
            <div class="step" id="step3">
                <span class="num">3</span>
                <span>تایید نهایی</span>
            </div>
        </div>

        <div class="order-grid" id="orderGrid">

            <!-- ستون راست: محصولات سبد -->
            <div class="card" id="productsCard">
                <div class="card-title">
                    <i class="fas fa-boxes"></i> محصولات سفارش
                    <span class="badge" id="itemCount">0</span>
                </div>
                <div id="selectedProductsList">
                    <div class="no-items">
                        <i class="fas fa-spinner fa-spin"></i>
                        <p>در حال بارگذاری سبد...</p>
                    </div>
                </div>
            </div>

            <!-- ستون چپ: نوع پرداخت -->
            <div class="card" id="paymentCard">
                <div class="card-title">
                    <i class="fas fa-credit-card"></i> نوع پرداخت
                </div>
                <div class="payment-options" id="paymentOptions">
                    <div style="text-align:center;padding:16px;color:var(--text-secondary);">
                        <i class="fas fa-spinner fa-spin"></i> در حال بارگذاری...
                    </div>
                </div>
            </div>

            <!-- خلاصه سفارش -->
            <div class="card" style="grid-column: 1 / -1;">
                <div class="card-title">
                    <i class="fas fa-calculator"></i> خلاصه سفارش
                </div>
                <div id="summaryItems"></div>
                <div class="summary-row">
                    <span class="total-label">مجموع سفارش:</span>
                    <span id="orderTotal">۰ تومان</span>
                </div>

                <button class="btn-submit-order" id="submitOrderBtn">
                    <i class="fas fa-check-circle"></i> ثبت و پرداخت
                </button>

                <button class="btn-pay" id="payOrderBtn" style="display:none;">
                    <i class="fas fa-credit-card"></i> پرداخت و تایید نهایی
                </button>
            </div>
        </div>
    </div>
    <!-- ═══ مودال انتخاب رنگ ═══ -->
    <div id="colorModal" class="modal-overlay" style="display:none;">
        <div class="modal-content">
            <div class="modal-header">
                <h3 id="colorModalTitle">انتخاب رنگ/مدل</h3>
                <button class="modal-close" type="button" onclick="CanselColorModal()">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="modal-body">
                <div id="colorModalList" class="color-modal-list">
                    <!-- رنگ‌ها با JS پر میشن -->
                </div>
            </div>
        </div>
    </div>
</div>

