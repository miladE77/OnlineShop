@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_LayoutMain.cshtml";
}

@section heads
{
    <title>مدیریت پرسنل</title>
}
@section scripts {
    <script src="/js/Personel/Personels.js"></script>
}
@section html
{
    lang="fa" dir="rtl"
}

<!-- مودال افزودن/ویرایش  پرسنل -->
<div class="main-content" id="mainContent">
    <div class="container">
        <div class="page-header">
            <h2><i class="fas fa-users"></i> مدیریت پرسنل</h2>
            <button class="btn-add" onclick="openAddModal()"><i class="fas fa-plus"></i> افزودن پرسنل جدید</button>
        </div>

        <div class="stats-cards" id="statsCards"></div>

        <div class="search-filter-bar">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" id="searchPersonel" placeholder="جستجو بر اساس ایتم ها...">
            </div>
            <select id="statusFilter" class="filter-select">
                <option value="all">همه وضعیت‌ها</option>
                <option value="true">فعال</option>
                <option value="false">غیرفعال</option>
            </select>
        </div>

        <div class="table-wrapper">
            <table id="personelTable">
                <thead>
                    <tr>
                        <th>شناسه</th>
	 <th>نام</th>
	 <th>نام خانوادگی</th>
	 <th>تاریخ تولد</th>
	 <th>کد ملی</th>
	 <th>آدرس محل سکونت</th>
	 <th>توضیحات بیشتر</th>
	 <th>وضعیت</th>
	 <th>سمت</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody id="PersonelTableBody"></tbody>
            </table>
        </div>
    </div>
</div>

<div id="PersonelModal" class="modal-overlay">
    <div class="modal modelInput">
        <h3 id="modalTitle">افزودن پرسنل جدید</h3>
        
 <input type="number" id="PersonelId" placeholder="شناسه">
 <input type="text" id="FirstName" placeholder="نام">
 <input type="text" id="LastName" placeholder="نام خانوادگی">
 <input type="text" id="Date_of_birth" placeholder="تاریخ تولد">
 <input type="text" id="Lational_code" placeholder="کد ملی">
 <input type="text" id="Address" placeholder="آدرس محل سکونت">
 <input type="text" id="Detail" placeholder="توضیحات بیشتر">
<div style="display:flex;">
 <label>وضعیت</label> <input type="checkbox" id="Status" placeholder="وضعیت" style="width: 10%;
  margin-top: 5px;">
</div>
<div style="display:flex;">
 <label style="align-content: center;padding: 12px;margin-bottom: 16px;width: auto;">سمت</label> 
<select id="Role" class="filter-select">
</select>
</div>
        <div class="modal-buttons">
            <button class="btn-save" onclick="SaveNewModel()">ذخیره</button>
            <button class="btn-cancel" onclick="CanselSaveModal()">انصراف</button>
        </div>
    </div>
</div>




