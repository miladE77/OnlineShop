@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_LayoutMain.cshtml";
}
@Html.AntiForgeryToken()

@section heads
{
    <title>مدیریت  پاسخ مشتری ها</title>
}
@section scripts {
    <script src="/js/AnswerCustomer/AnswerCustomers.js"></script>
}
@section html
{
    lang="fa" dir="rtl"
}
<!-- مودال افزودن/ویرایش   پاسخ مشتری ها -->
<div class="main-content" id="mainContent">
    <div class="container">
        <div class="page-header">
            <h2><i class="fas fa-users"></i> مدیریت  پاسخ مشتری ها</h2>
            <button class="btn-add" onclick="openAddModal()"><i class="fas fa-plus"></i> افزودن  پاسخ مشتری ها جدید</button>
        </div>

        <div class="stats-cards" id="statsCards"></div>

        <div class="search-filter-bar">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" id="searchAnswerCustomer" placeholder="جستجو بر اساس ایتم ها...">
            </div>
            <select id="statusFilter" class="filter-select">
                <option value="all">همه وضعیت‌ها</option>
                <option value="true">فعال</option>
                <option value="false">غیرفعال</option>
            </select>
        </div>

        <div class="table-wrapper">
            <table id="personelTable">
                <thead>
                    <tr>
                        <th>شناسه</th>
	 <th>عنوان پاسخ</th>
	 <th>سوال</th>
	 <th>تاریخ پاسخ</th>
	 <th>وضعیت</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody id="AnswerCustomerTableBody"></tbody>
            </table>
        </div>
    </div>
</div>

<div id="AnswerCustomerModal" class="modal-overlay">
    <div class="modal modelInput">
        <h3 id="modalTitle">افزودن  پاسخ مشتری ها جدید</h3>
        
 <input type="number" id="AnswerCustomerId" placeholder="شناسه">
 <input type="text" id="AnswerCustomerCaption" placeholder="عنوان پاسخ">
<div style="display:flex;">
 <label style="align-content: center;padding: 12px;margin-bottom: 16px;width: auto;">سوال</label> 
<select id="ContactUs" class="filter-select">
</select>
</div>
 <input type="date" id="AnswerDate" placeholder="تاریخ پاسخ">
<div style="display:flex;">
 <label>وضعیت</label> <input type="checkbox" id="Status" placeholder="وضعیت" style="width: 10%;
  margin-top: 5px;">
</div>
        <div class="modal-buttons">
            <button class="btn-save" onclick="SaveNewModel()">ذخیره</button>
            <button class="btn-cancel" onclick="CanselSaveModal()">انصراف</button>
        </div>
    </div>
</div>




