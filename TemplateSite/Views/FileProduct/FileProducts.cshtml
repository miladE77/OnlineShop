@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_LayoutMain.cshtml";
}

@section heads
{
    <title>مدیریت آرشیو محصولات</title>
}
@section scripts {
    <script src="/js/FileProduct/FileProducts.js"></script>
}
@section html
{
    lang="fa" dir="rtl"
}

<!-- مودال افزودن/ویرایش  آرشیو محصولات -->
<div class="main-content" id="mainContent">
    <div class="container">
        <div class="page-header">
            <h2><i class="fas fa-users"></i> مدیریت آرشیو محصولات</h2>
            <button class="btn-add" onclick="openAddModal()"><i class="fas fa-plus"></i> افزودن آرشیو محصولات جدید</button>
            <button class="btn-add" onclick="saveToStorage()"><i class="fas fa-plus"></i> تازه سازی</button>
        </div>

        <div class="stats-cards" id="statsCards"></div>

        <div class="search-filter-bar">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" id="searchFileProduct" placeholder="جستجو بر اساس ایتم ها...">
            </div>
            <select id="statusFilter" class="filter-select">
                <option value="all">همه وضعیت‌ها</option>
                <option value="true">فعال</option>
                <option value="false">غیرفعال</option>
            </select>
        </div>

        <div class="table-wrapper">
            <table id="personelTable">
                <thead>
                    <tr>
                        <th>شناسه</th>
	 <th>عنوان فایل</th>
	 <th>توضیحات</th>
	 <th>محصول</th>
	 <th>وضعیت</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody id="FileProductTableBody"></tbody>
            </table>
        </div>
    </div>
</div>

<div id="FileProductModal" class="modal-overlay">
    <div class="modal modelInput">
        <h3 id="modalTitle">افزودن آرشیو محصولات جدید</h3>
        
 <input type="number" id="FileProductId" placeholder="شناسه">
        <div style="display:flex;">
            <label style="align-content: center;padding: 12px;margin-bottom: 16px;width: auto;">فایل</label>
            <input type="file" id="FileProductCaption" placeholder="فایل">
        </div>

 <input type="text" id="Detail" placeholder="توضیحات">
<div style="display:flex;">
 <label style="align-content: center;padding: 12px;margin-bottom: 16px;width: auto;">محصول</label> 
<select id="Product" class="filter-select">
</select>
</div>
<div style="display:flex;">
 <label>وضعیت</label> <input type="checkbox" id="Status" placeholder="وضعیت" style="width: 10%;margin-top: 5px;">
</div>
        <div class="modal-buttons">
            <button class="btn-save" onclick="SaveNewModel()">ذخیره</button>
            <button class="btn-cancel" onclick="CanselSaveModal()">انصراف</button>
        </div>
    </div>
</div>




