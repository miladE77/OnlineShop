@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_LayoutMain.cshtml";
}

@section heads
{
    <title>مدیریت توکن دسترسی</title>
}
@section scripts {
    <script src="/js/Tocken/Tockens.js"></script>
}
@section html
{
    lang="fa" dir="rtl"
}

<!-- مودال افزودن/ویرایش  توکن دسترسی -->
<div class="main-content" id="mainContent">
    <div class="container">
        <div class="page-header">
            <h2><i class="fas fa-users"></i> مدیریت توکن دسترسی</h2>
            <button class="btn-add" onclick="openAddModal()"><i class="fas fa-plus"></i> افزودن توکن دسترسی جدید</button>
        </div>

        <div class="stats-cards" id="statsCards"></div>

        <div class="search-filter-bar">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" id="searchTocken" placeholder="جستجو بر اساس ایتم ها...">
            </div>
            <select id="statusFilter" class="filter-select">
                <option value="all">همه وضعیت‌ها</option>
                <option value="true">فعال</option>
                <option value="false">غیرفعال</option>
            </select>
        </div>

        <div class="table-wrapper">
            <table id="personelTable">
                <thead>
                    <tr>
                        <th>شناسه</th>
	 <th>عنوان توکن</th>
	 <th>توضیحات توکن</th>
	 <th>وضعیت</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody id="TockenTableBody"></tbody>
            </table>
        </div>
    </div>
</div>

<div id="TockenModal" class="modal-overlay">
    <div class="modal modelInput">
        <h3 id="modalTitle">افزودن توکن دسترسی جدید</h3>
        
 <input type="number" id="TockenId" placeholder="شناسه">
 <input type="text" id="TockenCaption" placeholder="عنوان توکن">
 <input type="text" id="TockenDetail" placeholder="توضیحات توکن">
<div style="display:flex;">
 <label>وضعیت</label> <input type="checkbox" id="Status" placeholder="وضعیت" style="width: 10%;
  margin-top: 5px;">
</div>
        <div class="modal-buttons">
            <button class="btn-save" onclick="SaveNewModel()">ذخیره</button>
            <button class="btn-cancel" onclick="CanselSaveModal()">انصراف</button>
        </div>
    </div>
</div>



<div id="LevelAccessTockenModal" class="modal-overlay">
    <div class="modal modelTable">
        <div class="modelRelative">
            <div style="align-content: center;">
                <h3 id="modalLevelAccessTockenTitle">دسترسی سیستم مرتبط</h3>
            </div><div>
                <button onclick="openModal('AddLevelAccessTockenModal')" class="btn-add">
                    افزودن
                </button>
            </div>
        </div>
        <div class="table-wrapper">
            <table id="LevelAccessTockenTable">
                <thead>
                    <tr>
                        <th>عنوان دسترسی سیستم</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody id="LevelAccessTockenTableBody">
                </tbody>
            </table>
        </div>
    </div>
</div>
<div id="AddLevelAccessTockenModal" class="modal-overlay">
    <div class="modal modelInput">
        <h3 id="modalTitle">افزودن دسترسی سیستم مرتبط جدید</h3>
        <select id="LevelAccessTockenId" class="filter-select">
        </select>
        <div class="modal-buttons">
            <button class="btn-save" onclick="saveLevelAccessTocken()">ذخیره</button>
            <button class="btn-cancel" onclick="closeModal('AddLevelAccessTockenModal')">انصراف</button>
        </div>
    </div>
</div>



