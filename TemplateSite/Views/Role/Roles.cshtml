@{
    ViewData["Title"] = "مدیریت نقش سیستم";
    Layout = "~/Views/Shared/_LayoutMain.cshtml";
}

@section heads
{
    <title>مدیریت نقش سیستم</title>
}

@section scripts {
    <script src="/js/Role/Roles.js"></script>
}

@section html
{
    lang="fa" dir="rtl"
}

<div class="main-content" id="mainContent">
    <div class="container">
        <div class="page-header">
            <h2><i class="fas fa-user-tag"></i> مدیریت نقش سیستم</h2>
            <button class="btn-add" onclick="openAddModal()">
                <i class="fas fa-plus"></i> افزودن نقش جدید
            </button>
        </div>

        <div class="stats-cards" id="statsCards"></div>

        <div class="search-filter-bar">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" id="searchRole" placeholder="جستجو بر اساس عنوان نقش...">
            </div>
            <select id="statusFilter" class="filter-select">
                <option value="all">همه وضعیت‌ها</option>
                <option value="true">فعال</option>
                <option value="false">غیرفعال</option>
            </select>
        </div>

        <div class="table-wrapper">
            <table id="roleTable">
                <thead>
                    <tr>
                        <th>شناسه</th>
                        <th>عنوان نقش</th>
                        <th>دسترسی‌های مرتبط</th>
                        <th>وضعیت</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody id="RoleTableBody"></tbody>
            </table>
        </div>
    </div>
</div>

<!-- ═══════════════════════════════════════════════════════
     Modal افزودن/ویرایش
     ═══════════════════════════════════════════════════════ -->
<div id="RoleModal" class="modal-overlay">
    <div class="modal modelInput">
        <h3 id="modalTitle">افزودن نقش جدید</h3>

        <input type="hidden" id="RoleId" value="0" />

        <input type="text" id="RoleCaption" placeholder="عنوان نقش *" maxlength="100" />

        <div style="margin-bottom:16px;">
            <label style="display:block; margin-bottom:8px; font-weight:600;">دسترسی‌های مرتبط</label>
            <div id="levelAccessList" style="max-height:220px; overflow-y:auto; background:var(--bg-body); padding:10px; border-radius:12px; border:1px solid var(--border-light);">
                <div style="text-align:center; color:var(--text-secondary); padding:10px;">
                    <i class="fas fa-spinner fa-spin"></i> در حال بارگذاری...
                </div>
            </div>
        </div>

        <div style="display:flex; align-items:center; margin-bottom:16px;">
            <label style="margin:0 8px 0 0;">وضعیت</label>
            <input type="checkbox" id="Status" style="width:20px; height:20px;" />
        </div>

        <div class="modal-buttons">
            <button class="btn-save" onclick="SaveNewModel()">ذخیره</button>
            <button class="btn-cancel" onclick="CanselSaveModal()">انصراف</button>
        </div>
    </div>
</div>