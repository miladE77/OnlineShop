@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_LayoutMain.cshtml";
}

@section heads
{
    <title>مدیریت نقش سیستم</title>
}
@section scripts {
    <script src="/js/Role/Roles.js"></script>
}
@section html
{
    lang="fa" dir="rtl"
}

<!-- مودال افزودن/ویرایش  نقش سیستم -->
<div class="main-content" id="mainContent">
    <div class="container">
        <div class="page-header">
            <h2><i class="fas fa-users"></i> مدیریت نقش سیستم</h2>
            <button class="btn-add" onclick="openAddModal()"><i class="fas fa-plus"></i> افزودن نقش سیستم جدید</button>
        </div>

        <div class="stats-cards" id="statsCards"></div>

        <div class="search-filter-bar">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" id="searchRole" placeholder="جستجو بر اساس ایتم ها...">
            </div>
            <select id="statusFilter" class="filter-select">
                <option value="all">همه وضعیت‌ها</option>
                <option value="true">فعال</option>
                <option value="false">غیرفعال</option>
            </select>
        </div>

        <div class="table-wrapper">
            <table id="personelTable">
                <thead>
                    <tr>
                        <th>شناسه</th>
	 <th>عنوان نقش</th>
	 <th>وضعیت</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody id="RoleTableBody"></tbody>
            </table>
        </div>
    </div>
</div>

<div id="RoleModal" class="modal-overlay">
    <div class="modal modelInput">
        <h3 id="modalTitle">افزودن نقش سیستم جدید</h3>
        
 <input type="number" id="RoleId" placeholder="شناسه">
 <input type="text" id="RoleCaption" placeholder="عنوان نقش">
<div style="display:flex;">
 <label>وضعیت</label> <input type="checkbox" id="Status" placeholder="وضعیت" style="width: 10%;
  margin-top: 5px;">
</div>
        <div class="modal-buttons">
            <button class="btn-save" onclick="SaveNewModel()">ذخیره</button>
            <button class="btn-cancel" onclick="CanselSaveModal()">انصراف</button>
        </div>
    </div>
</div>


<div id="LevelAccessRoleModal" class="modal-overlay">
    <div class="modal modelTable">
        <div class="modelRelative">
            <div style="align-content: center;">
                <h3 id="modalLevelAccessRoleTitle">دسترسی سیستم مرتبط</h3>
            </div><div>
                <button onclick="openModal('AddLevelAccessRoleModal')" class="btn-add">
                    افزودن
                </button>
            </div>
        </div>
        <div class="table-wrapper">
            <table id="LevelAccessRoleTable">
                <thead>
                    <tr>
                        <th>عنوان دسترسی سیستم</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody id="LevelAccessRoleTableBody">
                </tbody>
            </table>
        </div>
    </div>
</div>
<div id="AddLevelAccessRoleModal" class="modal-overlay">
    <div class="modal modelInput">
        <h3 id="modalTitle">افزودن دسترسی سیستم مرتبط جدید</h3>
        <select id="LevelAccessRoleId" class="filter-select">
        </select>
        <div class="modal-buttons">
            <button class="btn-save" onclick="saveLevelAccessRole()">ذخیره</button>
            <button class="btn-cancel" onclick="closeModal('AddLevelAccessRoleModal')">انصراف</button>
        </div>
    </div>
</div>



