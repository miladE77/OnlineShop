@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_LayoutMain.cshtml";
}

@section heads
{
    <title>مدیریت محصولات</title>
    <link rel="stylesheet" href="/css/PeoductStyle.css">
}
@section scripts {
    <script src="/js/Product/Products.js"></script>
}
@section html
{
    lang="fa" dir="rtl"
}
<div class="main-content" id="mainContent">
    <div class="container">
        <div class="page-header">
            <h2><i class="fas fa-boxes"></i> مدیریت جامع محصولات</h2>
            <button class="btn-add" id="openProductModal"><i class="fas fa-plus"></i> افزودن محصول جدید</button>
        </div>

        <div class="stats-cards" id="statsCards"></div>

        <div class="search-filter-bar">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" id="searchProduct" placeholder="جستجو بر اساس نام، کد، دسته‌بندی...">
            </div>
            <select id="kindFilter" class="filter-select">
                <option value="all">همه دسته‌بندی‌ها</option>
            </select>
            <select id="statusFilter" class="filter-select">
                <option value="all">همه وضعیت‌ها</option>
                <option value="active">فعال</option>
                <option value="inactive">غیرفعال</option>
            </select>
        </div>

        <div class="table-wrapper">
            <table>
                <thead>
                    <tr>
                        <th style="width:40px;"></th>
                        <th>نام محصول</th>
                        <th>کد داخلی</th>
                        <th>دسته‌بندی</th>
                        <th>قیمت پایه</th>
                        <th>وضعیت</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody id="productsTableBody"></tbody>
            </table>
        </div>
    </div>
</div>
<!-- ===== مودال محصول اصلی ===== -->
<div class="modal-overlay" id="productModal">
    <div class="modal">
        <h3 id="modalTitle">افزودن محصول جدید</h3>
        <input type="text" id="prodCaption" placeholder="نام محصول *">
        <input type="text" id="prodCode" placeholder="کد داخلی">
        <select id="prodKind"><option value="">انتخاب دسته‌بندی *</option></select>
        <input type="number" id="prodPrice" placeholder="قیمت پایه (تومان)">
        <select id="prodStatus">
            <option value="true">فعال</option>
            <option value="false">غیرفعال</option>
        </select>
        <div class="modal-buttons">
            <button class="btn-save" id="saveProductBtn">ذخیره</button>
            <button class="btn-cancel" id="closeProductModal">انصراف</button>
        </div>
    </div>
</div>

<!-- ===== مودال رنگ (ColorPriceProduct) ===== -->
<div class="modal-overlay modal-sm" id="colorModal">
    <div class="modal">
        <h3 id="colorModalTitle">افزودن رنگ به محصول</h3>
        <input type="text" id="colorCaption" placeholder="نام رنگ *">
        <input type="number" id="colorPrice" placeholder="قیمت (تومان)">
        <input type="number" id="colorOffer" placeholder="تخفیف (درصد)">
        <input type="number" id="colorStock" placeholder="موجودی انبار">
        <select id="colorStatus">
            <option value="true">فعال</option>
            <option value="false">غیرفعال</option>
        </select>
        <input type="hidden" id="colorProductId">
        <div class="modal-buttons">
            <button class="btn-save" id="saveColorBtn">ذخیره</button>
            <button class="btn-cancel" id="closeColorModal">انصراف</button>
        </div>
    </div>
</div>

<!-- ===== مودال تصویر (FileProduct) ===== -->
<div class="modal-overlay modal-sm" id="fileModal">
    <div class="modal">
        <h3 id="fileModalTitle">افزودن تصویر به محصول</h3>
        <div style="display:flex;">
            <label style="align-content: center;padding: 12px;margin-bottom: 16px;width: auto;">فایل</label>
            <input type="file" id="FileProduct" placeholder="فایل">
        </div>
        <select id="fileStatus">
            <option value="true">فعال</option>
            <option value="false">غیرفعال</option>
        </select>
        <input type="hidden" id="fileProductId">
        <div class="modal-buttons">
            <button class="btn-save" id="saveFileBtn">ذخیره</button>
            <button class="btn-cancel" id="closeFileModal">انصراف</button>
        </div>
    </div>
</div>

<!-- ===== مودال توضیحات (DetailProduct) با انتخاب OptionProduct ===== -->
<div class="modal-overlay modal-sm" id="detailModal">
    <div class="modal">
        <h3 id="detailModalTitle">افزودن توضیحات به محصول</h3>
        <select id="detailOptionSelect">
            <option value="">انتخاب مشخصه فنی *</option>
        </select>
        <input type="text" id="detailCaption" placeholder="مقدار مشخصه">
        <select id="detailStatus">
            <option value="true">فعال</option>
            <option value="false">غیرفعال</option>
        </select>
        <input type="hidden" id="detailProductId">
        <div style="font-size:0.75rem;color:var(--text-secondary);margin-bottom:12px;">
            <i class="fas fa-info-circle"></i> ابتدا مشخصه فنی را انتخاب کنید، سپس مقدار آن را وارد کنید.
        </div>
        <div class="modal-buttons">
            <button class="btn-save" id="saveDetailBtn">ذخیره</button>
            <button class="btn-cancel" id="closeDetailModal">انصراف</button>
        </div>
    </div>
</div>




