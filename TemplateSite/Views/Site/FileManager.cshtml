﻿@using Domain.ViewModels;
@model FileViewModel
@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_AccountLayout.cshtml";
    var FilesInfo = ViewData["FilesInfo"]?.ToString() ?? "{}";
}

@section heads
{
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>مدیریت فایل</title>
    <link rel="stylesheet" href="/css/FileManager.css">
}
@section scripts
{
    <script>
        let fileTree = {
            id: 'root',
            name: 'ریشه',
            type: 'folder',
            isFolder: true,
            children: [],
            parent: null
        };

        let allNodes = new Map(); // برای دسترسی سریع به نودها
        let currentNode = fileTree; // نود فعلی
        let selectedItems = new Set(); // آیتم‌های انتخاب شده در نمای گرید
        let currentRenameItem = null;
        let expandedNodes = new Set(); // نودهای باز شده


        // داده‌های نمونه
        function initSampleData() {

            const sampleTree = {
                id: 'root',
                name: 'main',
                type: 'folder',
                isFolder: true,
                children: @Html.Raw(FilesInfo)
                            };

            fileTree = sampleTree;
            fileTree.parent = null;
            buildNodeMap(fileTree);
        }

        // ساخت Map برای دسترسی سریع
        function buildNodeMap(node) {
            allNodes.set(node.id, node);
            if (node.children) {
                node.children.forEach(child => {
                    child.parent = node;
                    buildNodeMap(child);
                });
            }
        }

        // ذخیره در localStorage
        function saveData() {
            localStorage.setItem('fileManagerTree', JSON.stringify(fileTree));
        }

        // بارگذاری از localStorage
        function loadData() {
            const saved = localStorage.getItem('fileManagerTree');
            if (saved != undefined) {
                fileTree = JSON.parse(saved);
                fileTree.parent = null;
                allNodes.clear();
                buildNodeMap(fileTree);
            } else {
                initSampleData();
            }
            renderTree();
            updateCurrentPath();
            renderFileGrid();
            updateStats();
        }

        // رندر درخت
        function renderTree() {
            const treeContainer = document.getElementById('treeView');
            treeContainer.innerHTML = renderTreeNode(fileTree, 0);

            // اضافه کردن event listener برای toggle ها
            document.querySelectorAll('.tree-toggle').forEach(toggle => {
                toggle.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const nodeId = toggle.getAttribute('data-id');
                    toggleNode(nodeId);
                });
            });

            // اضافه کردن event listener برای انتخاب نود
            document.querySelectorAll('.tree-node-content').forEach(content => {
                content.addEventListener('click', (e) => {
                    if (!e.target.classList.contains('tree-toggle')) {
                        const nodeId = content.getAttribute('data-id');
                        selectNode(nodeId);
                    }
                });
            });
        }

        function renderTreeNode(node, level) {
            const isExpanded = expandedNodes.has(node.id);
            const hasChildren = node.children && node.children.length > 0;
            const isCurrent = currentNode.id === node.id;

            let html = `
                                <div class="tree-node" style="margin-right: ${level * 20}px">
                                    <div class="tree-node-content ${isCurrent ? 'selected' : ''}" data-id="${node.id}" data-name="${node.name}">
                                        ${hasChildren ? `<span class="tree-toggle" data-id="${node.id}">${isExpanded ? '▼' : '▶'}</span>` : '<span style="width: 20px;"></span>'}
                                        <span class="tree-icon">${node.isFolder ? (isExpanded ? '📂' : '📁') : getFileIcon(node)}</span>
                                        <span class="tree-name">${escapeHtml(node.name)}</span>
                                        ${!node.isFolder ? `<span class="tree-badge">${formatFileSize(node.size)}</span>` : ''}
                                    </div>
                                    ${hasChildren ? `<div class="tree-children ${isExpanded ? 'expanded' : ''}">${node.children.map(child => renderTreeNode(child, level + 1)).join('')}</div>` : ''}
                                </div>
                            `;
            return html;
        }

        function toggleNode(nodeId) {
            if (expandedNodes.has(nodeId)) {
                expandedNodes.delete(nodeId);
            } else {
                expandedNodes.add(nodeId);
            }
            renderTree();
        }

        function selectNode(nodeId) {
            const node = allNodes.get(nodeId);
            console.log(node);
            if (node) {
                currentNode = node;
                selectedItems.clear();
                renderTree();
                updateCurrentPath();
                renderFileGrid();
            }
        }

        function updateCurrentPath() {
            const breadcrumb = document.getElementById('breadcrumb');
            const path = [];
            let node = currentNode;
            while (node && node.id !== 'root') {
                path.unshift(node);
                node = node.parent;
            }
            path.unshift(fileTree);

            breadcrumb.innerHTML = path.map((node, index) => `
                                <span class="breadcrumb-item" onclick="selectNode('${node.id}')">${node.name}</span>
                                ${index < path.length - 1 ? ' / ' : ''}
                            `).join('');

        }

        function renderFileGrid() {
            const grid = document.getElementById('fileGrid');
            const searchTerm = document.getElementById('searchBox').value.toLowerCase();

            let items = currentNode.children || [];

            if (searchTerm) {
                items = searchInTree(currentNode, searchTerm);
            }

            if (items.length === 0) {
                grid.innerHTML = `
                                    <div class="empty-state">
                                        <div class="file-icon">📂</div>
                                        <p>هیچ فایلی در این پوشه وجود ندارد</p>
                                        <button class="btn btn-primary" onclick="createFolder()" style="margin-top: 20px;">ایجاد پوشه جدید</button>
                                    </div>
                                `;
                return;
            }

            grid.innerHTML = items.map(item => `
                                <div class="file-item ${selectedItems.has(item.id) ? 'selected' : ''}" onclick="toggleSelectItem('${item.id}', event)">
                                    <input type="checkbox" class="checkbox" ${selectedItems.has(item.id) ? 'checked' : ''} onclick="event.stopPropagation(); toggleSelectItem('${item.id}')">
                                    <div class="file-icon">${item.isFolder ? '📁' : getFileIcon(item)}</div>
                                    <div class="file-name">${escapeHtml(item.name)}</div>
                                    ${!item.isFolder ? `<div class="file-size">${formatFileSize(item.size)}</div>` : '<div class="file-size">پوشه</div>'}
                                    <div class="file-date">${formatDate(item.date)}</div>
                                </div>
                            `).join('');
        }

        function searchInTree(node, term) {
            let results = [];
            if (node.name.toLowerCase().includes(term) && node.id !== 'root') {
                results.push(node);
            }
            if (node.children) {
                node.children.forEach(child => {
                    results = results.concat(searchInTree(child, term));
                });
            }
            return results;
        }

        function toggleSelectItem(id, event) {
            if (selectedItems.has(id)) {
                selectedItems.delete(id);
            } else {
                selectedItems.add(id);
            }
            renderFileGrid();
        }



        function renameSelected() {
            if (selectedItems.size !== 1) {
                showNotification('لطفاً دقیقاً یک آیتم را انتخاب کنید', 'warning');
                return;
            }

            const itemId = Array.from(selectedItems)[0];
            currentRenameItem = currentNode.children.find(i => i.id === itemId);
            document.getElementById('newFileName').value = currentRenameItem.name;
            document.getElementById('renameModal').style.display = 'flex';
        }

        let path = "";
        let typeNameInput = 0;
        function resetModels(){
            document.getElementById('titleModal').innerHTML = "نام";
            document.getElementById('enterName').style.display = 'flex';
            document.getElementById('selectName').style.display = 'none';
            document.getElementById('newFileName').value = "";
            document.getElementById('renameModal').style.display = 'none';
        }
        function createTemplate() {
            if (selectedItems.size === 0) {
                showNotification('لطفاً حداقل یک آیتم را انتخاب کنید', 'warning');
                return;
            }
            let itemSelected = currentNode.children.filter(item => selectedItems.has(item.id));
            if (itemSelected.length > 1) {
                showNotification('لطفاً حداکثر یک آیتم را انتخاب کنید', 'warning');
                return;
            }
            if (itemSelected[0].isFolder) {
                showNotification('فقط امکان انتخاب فایل وجود دارد', 'error');
                return;
            }
            typeNameInput = 1;
            document.getElementById('newFileName').value = itemSelected[0].name;
            document.getElementById('renameModal').style.display = 'flex';
            document.getElementById('titleModal').innerHTML = "نوع فایل";
            document.getElementById('enterName').style.display = 'none';
            document.getElementById('selectName').style.display = 'flex';
            document.getElementById('newFileName').value = path;
        }
        function createFile() {
            let itemSelected = currentNode.children.filter(item => selectedItems.has(item.id));
            if (itemSelected.length > 1) {
                showNotification('لطفاً حداکثر یک آیتم را انتخاب کنید', 'warning');
                return;
            }
            if (itemSelected[0].isFolder) {
                showNotification('فقط امکان انتخاب فایل وجود دارد', 'error');
                return;
            }
            typeNameInput = 0;
            document.getElementById('newFileName').value = itemSelected[0].name;
            document.getElementById('renameModal').style.display = 'flex';
            document.getElementById('titleModal').innerHTML = "نام فایل جدید";
            document.getElementById('enterName').style.display = 'flex';
            document.getElementById('selectName').style.display = 'none';
        }
        function GetPathFull(itemInput) {
            if (itemInput.parent != null) {
                let parent = GetPathFull(itemInput.parent);
                if (parent != "") {
                    if (itemInput.isFolder) {
                        return GetPathFull(itemInput.parent) + "/" + itemInput.name;
                    } else {
                        return GetPathFull(itemInput.parent) + "/" + itemInput.name + itemInput.type;
                    }
                } else {
                    if (itemInput.isFolder) {
                        return itemInput.name;
                    } else {
                        return itemInput.name + itemInput.type;
                    }
                }
            }
            else {
                return "";
            }
        }
        function usedTemp() {
            let classesNames = "";
            let itemSelected = currentNode.children.filter(item => selectedItems.has(item.id));
            if (itemSelected.length == 0) {
                showNotification('لطفاً حداقل یک آیتم را انتخاب کنید', 'warning');
                return;
            }
            itemSelected.forEach(classItem => {
                console.log(classItem);
                if (classItem.isFolder) {
                    showNotification('فقط امکان انتخاب فایل وجود دارد', 'error');
                    return;
                }
                if (classItem.type != ".cs") {
                    showNotification('فقط امکان انتخاب فایل های cs وجود دارد', 'error');
                    return;
                }
                if (classesNames == "") {
                    classesNames = classItem.name;
                }
                else {
                    classesNames = classesNames + "," + classItem.name;
                }
            });
            $.post('/Management/UseTempelet', { 'FileName': classesNames }, function (response) {
                showNotification('آیتم‌ها با موفقیت اضافه شدند', 'success');
            });
        }



        function createFolder() {
            document.getElementById('folderModal').style.display = 'flex';
        }
        function SendToSql() {
            let classesNames = "";
            let itemSelected = currentNode.children.filter(item => selectedItems.has(item.id));
            if (itemSelected.length == 0) {
                showNotification('لطفاً حداقل یک آیتم را انتخاب کنید', 'warning');
                return;
            }
            itemSelected.forEach(classItem => {
                console.log(classItem);
                if (classItem.isFolder) {
                    showNotification('فقط امکان انتخاب فایل وجود دارد', 'error');
                    return;
                }
                if (classItem.type != ".cs") {
                    showNotification('فقط امکان انتخاب فایل های cs وجود دارد', 'error');
                    return;
                }
                if (classesNames == "") {
                    classesNames = classItem.name;
                }
                else {
                    classesNames = classesNames + "," + classItem.name;
                }
            });
            if (classesNames != "") {
                $.post('/Management/SendToSql', { 'ClassName': classesNames }, function (response) {
                    showNotification('با موفقیت انتقال کرد', 'success');
                });
            }
        }

        function confirmRename() {
            let itemSelected = currentNode.children.filter(item => selectedItems.has(item.id));
            if (typeNameInput == 1) {
                let typeFile = document.getElementById('typeFile').value.trim();
                $.post('/Management/CreateTempelet', { 'PathSelected': GetPathFull(itemSelected[0]), 'FileName': typeFile }, function (response) {
                    showNotification('با موفقیت اعمال گردید', 'success');
                });
                resetModels();
            } else if (typeNameInput == 0) {
                const newName = document.getElementById('newFileName').value.trim();
                if (!newName) {
                    showNotification('نام نمی‌تواند خالی باشد', 'error');
                    return;
                }
                if (newName == itemSelected[0].name) {
                    showNotification('فایل با این نام وجود دارد', 'error');
                    return;
                }

                $.post('/Management/EditeFile', { 'PathSelected': GetPathFull(itemSelected[0]), 'FileName': newName }, function (response) {
                    showNotification('با موفقیت تغییر کرد', 'success');
                });
                const newFile = {
                    id: Date.now().toString(),
                    name: newName,
                    type: itemSelected[0].type,
                    isFolder: false,
                    children: [],
                    parent: currentNode,
                    date: new Date().toISOString()
                };

                if (!currentNode.children) currentNode.children = [];
                currentNode.children.push(newFile);
                allNodes.set(newFile.id, newFile);
                //saveData();
                renderTree();
                renderFileGrid();
                updateStats();
                document.getElementById('newFileName').value = '';
            } else {
                
            }
            closeModal('renameModal');
        }
        function deleteSelected() {
            if (selectedItems.size === 0) {
                showNotification('لطفاً حداقل یک آیتم را انتخاب کنید', 'warning');
                return;
            }
            let itemSelected = currentNode.children.filter(item => selectedItems.has(item.id));
            if (itemSelected.length > 1) {
                showNotification('لطفاً حداکثر یک آیتم را انتخاب کنید', 'warning');
                return;
            }
            if (itemSelected[0].isFolder) {
                showNotification('فقط امکان انتخاب فایل وجود دارد', 'error');
                return;
            }

            $.post('/Management/DeleteFile', { 'PathSelected': GetPathFull(itemSelected[0]) }, function (response) {
                showNotification('آیتم‌ها با موفقیت حذف شدند', 'success');
            });

            if (confirm(`آیا از حذف ${selectedItems.size} آیتم مطمئن هستید؟`)) {
                currentNode.children = currentNode.children.filter(item => !selectedItems.has(item.id));
                selectedItems.forEach(id => allNodes.delete(id));
                selectedItems.clear();
                //saveData();
                allNodes.clear();
                buildNodeMap(fileTree);
                renderTree();
                renderFileGrid();
                updateStats();
            }
        }
        function GeneratorUserTable() {
            $.post('/Management/GeneratorUserTable', function (response) {
                showNotification('با موفقیت اعمال گردید', 'success');
            });
        }
        function CopyPathFile() {
            if (selectedItems.size === 0) {
                showNotification('لطفاً حداقل یک آیتم را انتخاب کنید', 'warning');
                return;
            }
            let itemSelected = currentNode.children.filter(item => selectedItems.has(item.id));
            if (itemSelected.length > 1) {
                showNotification('لطفاً حداکثر یک آیتم را انتخاب کنید', 'warning');
                return;
            }
            path = GetPathFull(itemSelected[0]);
            showNotification('Path کپی گردید', 'success');
        }


        function confirmCreateFolder() {
            const folderName = document.getElementById('folderName').value.trim();
            if (!folderName) {
                showNotification('نام پوشه نمی‌تواند خالی باشد', 'error');
                return;
            }

            const newFolder = {
                id: Date.now().toString(),
                name: folderName,
                type: 'folder',
                isFolder: true,
                children: [],
                parent: currentNode,
                date: new Date().toISOString()
            };

            if (!currentNode.children) currentNode.children = [];
            currentNode.children.push(newFolder);
            allNodes.set(newFolder.id, newFolder);
            saveData();
            renderTree();
            renderFileGrid();
            updateStats();
            closeModal('folderModal');
            document.getElementById('folderName').value = '';
            showNotification('پوشه با موفقیت ایجاد شد', 'success');
        }
        function showUploadDialog() {
            document.getElementById('uploadModal').style.display = 'flex';
        }

        function uploadFiles() {
            const input = document.getElementById('fileUpload');
            const newFiles = Array.from(input.files);

            if (newFiles.length === 0) {
                showNotification('لطفاً حداقل یک فایل انتخاب کنید', 'warning');
                return;
            }

            newFiles.forEach(file => {
                const newFile = {
                    id: Date.now() + Math.random().toString(),
                    name: file.name,
                    type: file.type.split('/')[0],
                    size: file.size,
                    date: new Date().toISOString(),
                    isFolder: false
                };

                if (!currentNode.children) currentNode.children = [];
                currentNode.children.push(newFile);
                allNodes.set(newFile.id, newFile);
            });

            saveData();
            renderTree();
            renderFileGrid();
            updateStats();
            closeModal('uploadModal');
            input.value = '';
            showNotification(`${newFiles.length} فایل با موفقیت آپلود شد`, 'success');
        }

        function expandAll() {
            expandAllNodes(fileTree);
            renderTree();
        }

        function expandAllNodes(node) {
            if (node.children) {
                expandedNodes.add(node.id);
                node.children.forEach(child => expandAllNodes(child));
            }
        }

        function collapseAll() {
            expandedNodes.clear();
            renderTree();
        }

        function searchFiles() {
            renderFileGrid();
        }

        function updateStats() {
            const totalFiles = countFiles(fileTree);
            const totalSize = calculateSize(fileTree);
            document.getElementById('stats').textContent = `${totalFiles} فایل | ${formatFileSize(totalSize)}`;
        }

        function countFiles(node) {
            let count = node.isFolder ? 0 : 1;
            if (node.children) {
                node.children.forEach(child => {
                    count += countFiles(child);
                });
            }
            return count;
        }

        function calculateSize(node) {
            let size = node.isFolder ? 0 : (node.size || 0);
            if (node.children) {
                node.children.forEach(child => {
                    size += calculateSize(child);
                });
            }
            return size;
        }

        function getFileIcon(file) {
            if (file.isFolder) return '📁';
            const ext = file.name.split('.').pop().toLowerCase();
            const icons = {
                'pdf': '📄', 'jpg': '🖼️', 'jpeg': '🖼️', 'png': '🖼️',
                'mp3': '🎵', 'mp4': '🎬', 'zip': '📦', 'txt': '📝',
                'doc': '📘', 'docx': '📘', 'xls': '📊', 'xlsx': '📊'
            };
            return icons[ext] || '📎';
        }

        function formatFileSize(bytes) {
            if (!bytes || bytes === 0) return '0 بایت';
            const k = 1024;
            const sizes = ['بایت', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
        }

        function formatDate(dateString) {
            if (!dateString) return 'نامشخص';
            const date = new Date(dateString);
            return date.toLocaleDateString('fa-IR');
        }

        function showNotification(message, type) {
            const notification = document.getElementById('notification');
            notification.textContent = message;
            notification.style.display = 'block';
            notification.style.background = type === 'error' ? '#f56565' : type === 'warning' ? '#ed8936' : '#48bb78';

            setTimeout(() => {
                notification.style.display = 'none';
            }, 3000);
        }

        function closeModal(modalId) {
            document.getElementById(modalId).style.display = 'none';
        }

        function escapeHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        window.onclick = function (event) {
            if (event.target.classList.contains('modal')) {
                event.target.style.display = 'none';
            }
        }

        // مقداردهی اولیه
        loadData();
    </script>
    <script>
        let propertiesList = [];
        const modalOverlay = document.getElementById('classModal');
        const addPropBtn = document.getElementById('addPropertyBtn');
        const propNameInput = document.getElementById('propNameInput');
        const propFaInput = document.getElementById('propFaInput');
        const propTypeSelect = document.getElementById('propTypeSelect');
        const propertiesContainer = document.getElementById('propertiesContainer');

        // تابع رندر کردن لیست پراپرتی‌ها در مودال
        function renderPropertiesList() {
            if (!propertiesContainer) return;
            if (propertiesList.length === 0) {
                propertiesContainer.innerHTML = `<div class="empty-msg">✨ هیچ پراپرتی ثبت نشده. با فرم بالا شروع کنید.</div>`;
                return;
            }

            let html = '';
            propertiesList.forEach((prop, index) => {
                // نمایش نوع به صورت خوانا
                let typeDisplay = prop.type;
                if (prop.type === 'string') typeDisplay = '🔤 string';
                else if (prop.type === 'number') typeDisplay = '#️⃣ number';
                else if (prop.type === 'boolean') typeDisplay = '✓ boolean';
                else if (prop.type === 'Date') typeDisplay = '📅 Date';
                else typeDisplay = `📌 ${prop.type}`;

                html += `
                <div class="prop-card" data-index="${index}">
                  <div class="prop-info">
                    <span class="prop-name">${escapeHtml(prop.name)}</span>
                    <span class="prop-fa">${escapeHtml(prop.Discription)}</span>
                    <span class="prop-type">${typeDisplay}</span>
                  </div>
                  <button class="remove-prop" data-index="${index}" title="حذف پراپرتی">🗑</button>
                </div>
              `;
            });
            propertiesContainer.innerHTML = html;

            // اتصال event listener به دکمه‌های حذف (رویداد delegation)
            const removeButtons = propertiesContainer.querySelectorAll('.remove-prop');
            removeButtons.forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const idx = btn.getAttribute('data-index');
                    if (idx !== null) {
                        removeProperty(parseInt(idx));
                    }
                });
            });
        }

        // حذف پراپرتی بر اساس ایندکس
        function removeProperty(index) {
            if (index >= 0 && index < propertiesList.length) {
                propertiesList.splice(index, 1);
                renderPropertiesList();
            }
        }

        // افزودن پراپرتی جدید از مقادیر ورودی ها
        function addPropertyFromInputs() {
            let name = propNameInput.value.trim();
            let Discription = propFaInput.value.trim();
            let type = propTypeSelect.value;

            // validation
            if (name === "") {
                alert("لطفاً نام پراپرتی (property name) را وارد کنید.");
                return false;
            }
            if (Discription === "") {
                alert("لطفاً عنوان فارسی را وارد کنید.");
                return false;
            }
            // بررسی تکراری نبودن نام پراپرتی (اختیاری اما بهتر)
            const isDuplicate = propertiesList.some(prop => prop.name === name);
            if (isDuplicate) {
                alert(`نام پراپرتی "${name}" قبلاً اضافه شده است. لطفاً نام منحصربه‌فردی انتخاب کنید.`);
                return false;
            }

            // اضافه کردن به آرایه
            propertiesList.push({
                name: name,
                Discription: Discription,
                type: type
            });

            // پاک کردن فیلدها
            propNameInput.value = "";
            propFaInput.value = "";
            propTypeSelect.value = "string";  // بازنشانی به حالت پیش‌فرض

            // رندر مجدد
            renderPropertiesList();
            return true;
        }

        // تابع ارسال رشته کلاس (شبیه سازی ارسال به سرور یا هر جای دیگر)
        function submitClassAndSendString() {
            if (propertiesList.length === 0) {
                alert("هیچ پراپرتی برای کلاس تعریف نشده است. لطفاً حداقل یک پراپرتی اضافه کنید.");
                return;
            }
            let className = document.getElementById("classNameInput").value;
            let classDiscription = document.getElementById("classDiscrptionInput").value;
            $.post('/Management/CreateNewClass', { 'ClassProp': propertiesList, 'ClassName': className + ":" + classDiscription }, function (response) {
                showNotification('با موفقیت ایجاد گردید', 'success');
            });
            closeClassModal();
        }
        function escapeHtml(str) {
            if (!str) return "";
            return str.replace(/[&<>]/g, function (m) {
                if (m === '&') return '&amp;';
                if (m === '<') return '&lt;';
                if (m === '>') return '&gt;';
                return m;
            }).replace(/[\uD800-\uDBFF][\uDC00-\uDFFF]/g, function (c) {
                return c;
            });
        }
        function openModal() {
            propertiesList = [];
            renderPropertiesList();
            propNameInput.value = "";
            propFaInput.value = "";
            propTypeSelect.value = "string";
            modalOverlay.classList.add('active');
        }
        function closeClassModal() {
            modalOverlay.classList.remove('active');
        }

        // کلیک روی overlay بسته شود
        modalOverlay.addEventListener('click', (e) => {
            if (e.target === modalOverlay) {
                closeClassModal();
            }
        });
        // افزودن پراپرتی با دکمه مخصوص
        addPropBtn.addEventListener('click', () => {
            addPropertyFromInputs();
        });

        // اضافه کردن با اینتر (روی input ها, usability)
        const inputsForEnter = [propNameInput, propFaInput, propTypeSelect];
        inputsForEnter.forEach(input => {
            input.addEventListener('keypress', (e) => {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    addPropertyFromInputs();
                }
            });
        });
    </script>
}
