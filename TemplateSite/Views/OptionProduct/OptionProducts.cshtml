@{
    ViewData["Title"] = "Register";
    Layout = "~/Views/Shared/_LayoutMain.cshtml";
}

@section heads
{
    <title>مدیریت مشخصات فنی هر نوع محصول</title>
}
@section scripts {
    <script src="/js/OptionProduct/OptionProducts.js"></script>
}
@section html
{
    lang="fa" dir="rtl"
}

<!-- مودال افزودن/ویرایش  مشخصات فنی هر نوع محصول -->
<div class="main-content" id="mainContent">
    <div class="container">
        <div class="page-header">
            <h2><i class="fas fa-users"></i> مدیریت مشخصات فنی هر نوع محصول</h2>
            <button class="btn-add" onclick="openAddModal()"><i class="fas fa-plus"></i> افزودن مشخصات فنی هر نوع محصول جدید</button>
        </div>

        <div class="stats-cards" id="statsCards"></div>

        <div class="search-filter-bar">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" id="searchOptionProduct" placeholder="جستجو بر اساس ایتم ها...">
            </div>
            <select id="statusFilter" class="filter-select">
                <option value="all">همه وضعیت‌ها</option>
                <option value="true">فعال</option>
                <option value="false">غیرفعال</option>
            </select>
        </div>

        <div class="table-wrapper">
            <table id="personelTable">
                <thead>
                    <tr>
                        <th>شناسه</th>
	 <th>عنوان مشخصه</th>
	 <th>نوع محصول</th>
	 <th>وضعیت</th>
                        <th>عملیات</th>
                    </tr>
                </thead>
                <tbody id="OptionProductTableBody"></tbody>
            </table>
        </div>
    </div>
</div>

<div id="OptionProductModal" class="modal-overlay">
    <div class="modal modelInput">
        <h3 id="modalTitle">افزودن مشخصات فنی هر نوع محصول جدید</h3>
        
 <input type="number" id="OptionProductId" placeholder="شناسه">
 <input type="text" id="OptionProductCaption" placeholder="عنوان مشخصه">
<div style="display:flex;">
 <label style="align-content: center;padding: 12px;margin-bottom: 16px;width: 30%;">نوع محصول</label> 
<select id="KindProduct" class="filter-select">
</select>
</div>
<div style="display:flex;">
 <label>وضعیت</label> <input type="checkbox" id="Status" placeholder="وضعیت" style="width: 10%;
  margin-top: 5px;">
</div>
        <div class="modal-buttons">
            <button class="btn-save" onclick="SaveNewModel()">ذخیره</button>
            <button class="btn-cancel" onclick="CanselSaveModal()">انصراف</button>
        </div>
    </div>
</div>




